# Supabase credentials for NutriCraft cloud sync.
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
#
# The anon (publishable) key is safe to ship in a client app — security is enforced
# by Row-Level Security policies on the database, not by hiding this key.
#
# Expo inlines any var prefixed EXPO_PUBLIC_ into the JS bundle automatically.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# OPTIONAL — USDA FoodData Central API key for online food search.
# Open Food Facts search needs no key; USDA does. Get a free one at
# https://fdc.nal.usda.gov/api-key-signup.html. Leave blank to disable USDA
# search (Open Food Facts still works). Restart the dev server after editing.
EXPO_PUBLIC_FDC_API_KEY=